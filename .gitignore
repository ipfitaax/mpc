# Student enquiries and newsletter subscribers.
#
# These are real people's names, phone numbers and email addresses. They are
# operational data, not source code, and committing them would publish personal
# details of prospective students to whoever can read the repository.
storage/*.jsonl
storage/*.log

# Keep the directory itself, and its deny rule, in the repo.
!storage/.htaccess

# Editor and OS noise
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
.gstack/

# Database credentials. The production copy lives above the web root; this is
# the local-development one. lib/.htaccess denies the directory either way, but
# a password does not belong in a repository whatever the web server thinks.
lib/config.local.php

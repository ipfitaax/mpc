# Force LF on everything that gets uploaded to the Linux host.
#
# Committed from Windows, so without this a fresh clone converts these to CRLF
# and uploads them that way. Apache is picky about stray carriage returns in
# .htaccess directives, and a PHP file with CRLF can emit them before the
# headers it is trying to set.
*.php       text eol=lf
*.html      text eol=lf
*.js        text eol=lf
*.md        text eol=lf
.htaccess   text eol=lf
.gitignore  text eol=lf

# .cpanel.yml is not just uploaded, it is EXECUTED: cPanel runs each task
# through a shell on the host. A CRLF turns `export DEPLOYPATH=$HOME/public_html`
# into a path with a carriage return on the end, and the copy lands somewhere
# that is not public_html. .sql for the same family of reason — these get piped
# into mysql on the host.
*.yml       text eol=lf
*.sql       text eol=lf

# Binary: never touch these.
*.png       binary
*.jpg       binary
*.ico       binary

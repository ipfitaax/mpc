<?xml version="1.0" encoding="UTF-8"?>
<!--
  The suite builds its own scratch database from database/ledger.sql on every
  run, so there is nothing to set up by hand beyond a working lib/config.local.php
  with owner credentials. See tests/bootstrap.php.

  Run it with:  composer test      (or)  vendor/bin/phpunit
-->
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
         cacheResultFile=".phpunit.cache/result"
         failOnWarning="true"
         failOnRisky="true"
         beStrictAboutOutputDuringTests="true">
    <testsuites>
        <testsuite name="ledger">
            <directory>tests</directory>
        </testsuite>
    </testsuites>
    <coverage>
        <include>
            <directory suffix=".php">lib</directory>
        </include>
    </coverage>
</phpunit>

# These files hold students' names, phone numbers and email addresses.
# Nothing in here may ever be served over HTTP.
#
# This directory sits inside the web root only because some shared hosts refuse
# to let anything live above it. Where the host allows it, create an
# `mpc-storage` directory ALONGSIDE public_html instead — api/shared.php
# prefers that automatically, and a file outside the document root cannot be
# requested at all, whatever a future Apache config does.

# Apache 2.4
<IfModule mod_authz_core.c>
    Require all denied
</IfModule>

# Apache 2.2
<IfModule !mod_authz_core.c>
    Order allow,deny
    Deny from all
</IfModule>
